<Application x:Class="D2RLevel.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#202833" />
    <Style x:Key="MenuSeparator" TargetType="Separator">
      <Setter Property="Margin" Value="8,4"/>
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#435267"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
        <Border Background="{TemplateBinding Background}"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#E6EDF4"/>
      <Setter Property="Background" Value="#202833"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Grid>
          <Border x:Name="MenuBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter x:Name="MenuHeader" ContentSource="Header" RecognizesAccessKey="True"/>
              <TextBlock x:Name="Checkmark" Text="✓" HorizontalAlignment="Right" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False">
            <Border Background="#202833" BorderBrush="#526479" BorderThickness="1" Padding="4">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/></Trigger>
          <Trigger Property="IsCheckable" Value="True"><Setter TargetName="MenuHeader" Property="Margin" Value="0,0,24,0"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="#354456"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE4ED" /></Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#202833"/>
      <Setter Property="Foreground" Value="#F4F7FA"/>
      <Setter Property="BorderBrush" Value="#8BA0B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MaxWidth" Value="420"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="#354456"/><Setter Property="Foreground" Value="#F4F7FA"/>
      <Setter Property="BorderBrush" Value="#526479"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8BD2D4"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/>
      <Setter Property="Background" Value="#141B23"/><Setter Property="Foreground" Value="#EEF3F8"/>
      <Setter Property="BorderBrush" Value="#435267"/><Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="#C7D6E5"/><Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="BorderBrush" Value="#435267"/>
    </Style>
  </Application.Resources>
</Application>
