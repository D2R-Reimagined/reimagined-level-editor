<Application x:Class="D2RLevel.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#202833" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE4ED" /></Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#202833"/>
      <Setter Property="Foreground" Value="#F4F7FA"/>
      <Setter Property="BorderBrush" Value="#8BA0B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MaxWidth" Value="420"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="#354456"/><Setter Property="Foreground" Value="#F4F7FA"/>
      <Setter Property="BorderBrush" Value="#526479"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8BD2D4"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/>
      <Setter Property="Background" Value="#141B23"/><Setter Property="Foreground" Value="#EEF3F8"/>
      <Setter Property="BorderBrush" Value="#435267"/><Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="#C7D6E5"/><Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="BorderBrush" Value="#435267"/>
    </Style>
  </Application.Resources>
</Application>
