<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Reimagined Level Editor</Product>
    <Title>Reimagined Level Editor</Title>
    <AssemblyTitle>Reimagined Level Editor</AssemblyTitle>
    <Description>HD preset and DS1 gameplay editor for Reimagined</Description>
    <ApplicationIcon>Assets/ReimaginedLevelEditor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ReimaginedLevelEditor.ico" />
    <ProjectReference Include="../D2RLevel.Assets/D2RLevel.Assets.csproj" />
    <Content Include="Native/granny2.dll" Condition="Exists('Native/granny2.dll') and '$(IncludeGrannyRuntime)' != 'false'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Native/NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
